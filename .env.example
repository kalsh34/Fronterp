# Backend the frontend talks to (must have no trailing slash and no /api suffix).
# Copy this file to .env and change the value when you want to point at another
# backend, e.g. a local one: VITE_API_URL=http://localhost:5000
# When unset, the app falls back to the deployed Render backend.
VITE_API_URL=https://erpback-tnsv.onrender.com
